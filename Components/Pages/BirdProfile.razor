@page "/bird/{Id:int}"
@inject BirdService BirdService
@inject IJSRuntime JS

<NavBar />

@if (loading)
{
    <p>Loading…</p>
}
else if (bird is null)
{
    <p>Bird not found.</p>
}
else
{
    <PageTitle>@bird.CommonName</PageTitle>
    //This is where each birds photo attribute will be displayed.
    <img src="@bird.PhotoUrl" alt="Photo of a @bird.CommonName" class="bird-photo" />
    @if (featured is not null)
    {
        <p class="photo-credit">
            Photo:
            @if (featured.PageUrl is not null)
            {
                <a href="@featured.PageUrl" target="_blank" rel="noopener">@featured.Author</a>
            }
            else
            {
                @featured.Author
            }
            @if (featured.LicenseUrl is not null)
            {
                <text>, </text><a href="@featured.LicenseUrl" target="_blank" rel="noopener">@featured.LicenseName</a>
            }
            else
            {
                <text>, @featured.LicenseName</text>
            }
            <text>, via @featured.Source</text>
        </p>
    }

    <div class="bird-info">
        <h1>@bird.CommonName</h1>
        @if (bird.CommonPronunciation is not null)
        {
            <p class="pronunciation">@bird.CommonPronunciation</p>
        }
        <p><em>@bird.LatinName</em></p>
        @if (bird.LatinPronunciation is not null)
        {
            <p class="pronunciation">@bird.LatinPronunciation</p>
        }
        <button type="button" class="listen-button" aria-label="Hear how to say @bird.CommonName and @bird.LatinName"
        
        @onclick="SpeakNamesAsync">
            <img src="images/icons/listenIcon.svg" alt="" />
        </button>

        @if (bird.Description is not null)
        {
            <p class="bird-description">@bird.Description</p>
        }
        
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Bird? bird;
    private BirdImage? featured;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        bird = await BirdService.GetByIdAsync(Id);
        featured = bird?.Images.FirstOrDefault(i => i.IsFeatured);
        loading = false;
    }

    //Listen button: says the common name, pauses, then says the Latin name (speakNames lives in App.razor)
    private async Task SpeakNamesAsync()
    {
        await JS.InvokeVoidAsync("speakNames", bird!.CommonName, bird.LatinName);
    }
}
