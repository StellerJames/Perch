@page "/login"
@using System.ComponentModel.DataAnnotations
@inject UserService UserService
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>LogIn</PageTitle>
<NavBar ShowHome="true" />
<h1 class="auth-title">Welcome Back</h1>

@if (CurrentUser.IsLoggedIn)
{
    <div class="auth-status">
        <p>You're logged in as @CurrentUser.Username</p>
        <button type="button" @onclick="CurrentUser.LogOut">Log Out</button>
    </div>
}

else
{
    <EditForm Model="form" OnValidSubmit="LoginAsync" class="auth-form">
        <DataAnnotationsValidator />

        <InputText id="username" placeholder="Username" aria-label="Username" @bind-Value="form.Username" />
        <ValidationMessage For="() => form.Username" />


        <InputText id="password" type="password" placeholder="Password" aria-label="Password" @bind-Value="form.Password" />
        <ValidationMessage For="() => form.Password" />
        <button type="submit">Log In</button>
    </EditForm>

    @if (errorMessage is not null)
    {
        <p class="error">@errorMessage</p>
    }

    <a href="create-account" class="auth-link">Create Account</a>
}

@code {
    private LoginForm form = new();
    private string? errorMessage;

    private class LoginForm
    {
        [Required]
        public string Username { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }

    private async Task LoginAsync()
    {
        var user = await UserService.LoginAsync(form.Username, form.Password);

        if (user is null)
        {
            errorMessage = "Username or password is incorrect.";
        }
        else
        {
            CurrentUser.LogIn(user);
            Navigation.NavigateTo("");
        }
    }
}
